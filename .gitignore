__pycache__/
*.pyc
*.egg-info/
build/
dist/
work/
runs/

# Prepared PDEBench assets are reproducible local outputs, not source data.
tasks/PDEBench_*/cases/*/
tasks/PDEBench_*/reference/*/
tasks/PDEBench_*/samples/*/input/*
!tasks/PDEBench_*/samples/*/input/.gitkeep
tasks/PDEBench_*/samples/*/output/*
!tasks/PDEBench_*/samples/*/output/.gitkeep
tasks/PDEBench_*/author/prepared/
tasks/PDEBench_*/author/sample-certificates/
tasks/PDEBench_*/author/preparation.json
