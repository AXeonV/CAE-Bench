set dimension = 2
subsection simulation control
 set method = steady
 set output name = solution
 set output frequency = 1
 set subdivision = 2
end
subsection physical properties
 subsection fluid 0
  set kinematic viscosity = 0.1
 end
end
subsection mesh
 set type = gmsh
 set file name = solver.msh
end
subsection FEM
 set velocity degree = 2
 set pressure degree = 1
end
subsection non-linear solver
 subsection fluid dynamics
  set tolerance = 1e-10
  set max iterations = 30
  set verbosity = verbose
 end
end
subsection linear solver
 subsection fluid dynamics
  set method = gmres
  set relative residual = 1e-6
  set minimum residual = 1e-12
  set preconditioner = amg
  set max iters = 1000
  set verbosity = verbose
 end
end
subsection boundary conditions
 set number = 4
 subsection bc 0
  set id = 2
  set type = function
  subsection u
   set Function expression = 0.0*(min(1,min((x-0.0)/0.5,(5.0-x)/0.5)))
  end
  subsection v
   set Function expression = 0.0*(min(1,min((x-0.0)/0.5,(5.0-x)/0.5)))
  end
 end
 subsection bc 1
  set id = 3
  set type = function
  subsection u
   set Function expression = 0.0*(min(1,min((x-0.0)/0.5,(5.0-x)/0.5)))
  end
  subsection v
   set Function expression = 0.0*(min(1,min((x-0.0)/0.5,(5.0-x)/0.5)))
  end
 end
 subsection bc 2
  set id = 4
  set type = function
  subsection u
   set Function expression = 0.0*(min(1,min((y-0.0)/0.5,(4.0-y)/0.5)))
  end
  subsection v
   set Function expression = 0.1*(min(1,min((y-0.0)/0.5,(4.0-y)/0.5)))
  end
 end
 subsection bc 3
  set id = 5
  set type = function
  subsection u
   set Function expression = 0.0*(min(1,min((y-0.0)/0.5,(4.0-y)/0.5)))
  end
  subsection v
   set Function expression = 0.0*(min(1,min((y-0.0)/0.5,(4.0-y)/0.5)))
  end
 end
end
