{
  "version": 2,
  "quantities": {
    "density": {
      "unit": "kg/m3",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-05,
        "rtol": 0.02
      }
    },
    "velocity": {
      "unit": "m/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.002,
        "rtol": 0.02
      }
    },
    "temperature": {
      "unit": "K",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.1,
        "rtol": 0.02
      }
    },
    "pressure": {
      "unit": "Pa",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.2,
        "rtol": 0.02
      }
    },
    "traction": {
      "unit": "Pa",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.2,
        "rtol": 0.02
      }
    },
    "heat_flux": {
      "unit": "W/m2",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.2,
        "rtol": 0.02
      }
    }
  }
}
