{
  "version": 1,
  "checks": [
    {
      "id": "outputs",
      "evaluator": "direct_outputs",
      "reference": "reference.h5",
      "policy": {
        "version": 2,
        "quantities": {
          "velocity": {
            "unit": "m/s",
            "rule": {
              "metric": "nrmse",
              "time": "per_time",
              "components": "per_component",
              "scale_floor": 0.01,
              "limit": 0.05
            }
          },
          "pressure": {
            "unit": "Pa",
            "rule": {
              "metric": "nrmse",
              "time": "per_time",
              "components": "per_component",
              "scale_floor": 2.0,
              "limit": 0.05
            }
          },
          "velocity_covariance": {
            "unit": "m2/s2",
            "rule": {
              "metric": "nrmse",
              "time": "per_time",
              "components": "per_component",
              "scale_floor": 0.01,
              "limit": 0.05
            }
          }
        }
      }
    }
  ],
  "scoring": {
    "metric": "max_nrmse",
    "full_credit": 0.05,
    "zero_credit": 0.1
  }
}
