{
  "version": 2,
  "quantities": {
    "velocity": {
      "unit": "m/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.01,
        "rtol": 0.05
      }
    },
    "pressure": {
      "unit": "Pa",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 2.0,
        "rtol": 0.05
      }
    },
    "temperature": {
      "unit": "K",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.2,
        "rtol": 0.02
      }
    },
    "velocity_covariance": {
      "unit": "m2/s2",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.01,
        "rtol": 0.1
      }
    },
    "temperature_variance": {
      "unit": "K2",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.05,
        "rtol": 0.1
      }
    },
    "turbulent_heat_flux": {
      "unit": "K.m/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.01,
        "rtol": 0.1
      }
    }
  }
}
