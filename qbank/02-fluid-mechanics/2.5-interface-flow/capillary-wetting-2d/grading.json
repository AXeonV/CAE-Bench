{
  "version": 2,
  "quantities": {
    "alpha": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.005,
        "rtol": 0.03
      }
    },
    "pressure": {
      "unit": "Pa",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1.0,
        "rtol": 0.03,
        "reference_offset": {
          "parameter": "pressure_reference"
        }
      }
    },
    "velocity": {
      "unit": "m/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.001,
        "rtol": 0.03
      }
    }
  }
}
