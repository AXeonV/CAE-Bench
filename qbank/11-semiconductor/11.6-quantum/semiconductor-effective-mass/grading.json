{
  "version": 2,
  "quantities": {
    "eigenenergy": {
      "unit": "J",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-25,
        "rtol": 0.0001
      }
    },
    "wavefunction": {
      "unit": "m^(-1/2)",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.01,
        "rtol": 0.003
      }
    }
  }
}
