        "rtol": 0.01
      }
    },
    "water_content": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.0001,
        "rtol": 0.01
      }
    },
    "darcy_velocity": {
      "unit": "m/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-08,
        "rtol": 0.01
      }
    }
  }
