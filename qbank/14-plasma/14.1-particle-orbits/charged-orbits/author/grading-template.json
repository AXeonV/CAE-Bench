{
  "version": 2,
  "quantities": {
    "position": {
      "unit": "m",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-05
      }
    },
    "velocity": {
      "unit": "m/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.001,
        "rtol": 1e-05
      }
    }
  }
}
