{
  "version": 2,
  "quantities": {
    "temperature_rise": {
      "unit": "K",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-05,
        "rtol": 0.002
      }
    },
    "displacement": {
      "unit": "m",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-09,
        "rtol": 0.002
      }
    },
    "axial_stress": {
      "unit": "Pa",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.01,
        "rtol": 0.002
      }
    }
  }
}
