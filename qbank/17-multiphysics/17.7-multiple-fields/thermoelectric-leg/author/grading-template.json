{
  "version": 2,
  "quantities": {
    "temperature": {
      "unit": "K",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-05,
        "rtol": 0.002
      }
    },
    "electric_potential": {
      "unit": "V",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-08,
        "rtol": 0.002
      }
    },
    "total_heat_flux": {
      "unit": "W/m2",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.0001,
        "rtol": 0.003
      }
    }
  }
}
