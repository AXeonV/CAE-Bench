{
  "version": 2,
  "quantities": {
    "absolute_pressure": {
      "unit": "Pa",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.001,
        "rtol": 0.002
      }
    },
    "mass_flow": {
      "unit": "kg/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-09,
        "rtol": 0.002
      }
    }
  }
}
