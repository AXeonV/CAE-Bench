{
  "version": 2,
  "quantities": {
    "temperature": {
      "unit": "K",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-05,
        "rtol": 0.002
      }
    },
    "heat_rate": {
      "unit": "W",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-05,
        "rtol": 0.002
      }
    }
  }
}
