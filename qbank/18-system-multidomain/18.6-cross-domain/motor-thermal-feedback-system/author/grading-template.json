        "time": "per_time",
        "components": "per_component",
        "atol": 1e-08,
        "rtol": 0.002
      }
    },
    "angular_velocity": {
      "unit": "rad/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 0.002
      }
    },
    "temperature": {
      "unit": "K",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-05,
        "rtol": 0.002
      }
    }
  }
}
