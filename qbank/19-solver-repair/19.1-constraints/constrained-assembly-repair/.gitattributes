*.md text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.Dockerfile text eol=lf
*.tar.gz binary
.gitattributes text eol=lf
# Captured evidence hashes describe the original bytes, including line endings.
author/data-evidence/* -text

# Raw frozen plan retains CRLF bytes; unified diff blank context carries one space.
author/data-evidence/benchmark-plan.json whitespace=cr-at-eol
author/data-evidence/luna-submission.diff whitespace=-blank-at-eol

# Preserve byte hashes of frozen exam and runtime materials.
public/** -text whitespace=cr-at-eol
instruction.md -text whitespace=cr-at-eol
DATA.md -text whitespace=cr-at-eol
extension/** -text whitespace=cr-at-eol
harbor/** -text whitespace=cr-at-eol
judge-config.json -text whitespace=cr-at-eol
public-materials.json -text whitespace=cr-at-eol
data-manifest.json -text whitespace=cr-at-eol
