{
  "version": 2,
  "quantities": {
    "acceleration": {"unit": "m/s^2", "rule": {"metric": "pointwise", "time": "per_time", "components": "per_component", "atol": 0.01, "rtol": 0.0005}},
    "reaction_force": {"unit": "N", "rule": {"metric": "pointwise", "time": "per_time", "components": "per_component", "atol": 0.05, "rtol": 0.0005}},
    "position": {"unit": "m", "rule": {"metric": "pointwise", "time": "per_time", "components": "per_component", "atol": 1e-8, "rtol": 1e-8}},
    "velocity": {"unit": "m/s", "rule": {"metric": "pointwise", "time": "per_time", "components": "per_component", "atol": 1e-8, "rtol": 1e-8}}
  }
}
