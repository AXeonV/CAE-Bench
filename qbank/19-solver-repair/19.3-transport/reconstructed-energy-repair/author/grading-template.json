{
  "version": 2,
  "quantities": {
    "temperature": {
      "unit": "K",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-10
      }
    },
    "velocity": {
      "unit": "m/s",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-10
      }
    },
    "pressure": {
      "unit": "Pa",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-10
      }
    },
    "density": {
      "unit": "kg/m^3",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-10
      }
    },
    "specific_total_enthalpy": {
      "unit": "J/kg",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-10
      }
    },
    "momentum_density": {
      "unit": "kg/(m^2*s)",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-10
      }
    },
    "total_energy_density": {
      "unit": "J/m^3",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 1e-10
      }
    },
    "flow_density": {
      "unit": "kg/m^3",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-05,
        "rtol": 2e-05
      }
    },
    "flow_momentum_density": {
      "unit": "kg/(m^2*s)",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.001,
        "rtol": 2e-05
      }
    },
    "flow_total_energy_density": {
      "unit": "J/m^3",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1.0,
        "rtol": 2e-05
      }
    },
    "skin_friction_coefficient": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-07,
        "rtol": 2e-05
      }
    },
    "log10_residual": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.5,
        "rtol": 0.0
      }
    }
  }
}
