{
  "version": 2,
  "quantities": {
    "normalized_finite_dft": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-09,
        "rtol": 1e-08
      }
    },
    "sampling_stride": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 0.0,
        "rtol": 0.0
      }
    },
    "normalized_time_step": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-12,
        "rtol": 1e-12
      }
    },
    "normalized_window_end": {
      "unit": "1",
      "rule": {
        "metric": "pointwise",
        "time": "per_time",
        "components": "per_component",
        "atol": 1e-10,
        "rtol": 1e-12
      }
    }
  }
}
