{
  "acoustic-transient": {
    "name": "线性声学瞬态传播",
    "family": "bounded",
    "transient": true,
    "parameters": {
      "start_time": {
        "unit": "s",
        "meaning": "物理初始时刻t0"
      },
      "end_time": {
        "unit": "s",
        "meaning": "末时刻tf，严格大于t0"
      }
    },
    "records": {
      "material": {
        "role": "material",
        "variable": "acoustic",
        "where": "cells",
        "data": {
          "density": {
            "unit": "kg/m3",
            "meaning": "背景密度ρ>0",
            "kind": "scalar",
            "shape": [
              1
            ],
            "positive": true
          },
          "sound_speed": {
            "unit": "m/s",
            "meaning": "声速c>0",
            "kind": "scalar",
            "shape": [
              1
            ],
            "positive": true
          }
        },
        "required": true,
        "static": true
      },
      "volume_source": {
        "role": "source",
        "variable": "dilatation",
        "where": "cells",
        "data": {
          "value": {
            "unit": "1/s",
            "meaning": "体积膨胀率源q",
            "kind": "scalar",
            "shape": [
              1
            ]
          }
        },
        "required": true,
        "static": false
      },
      "initial_pressure": {
        "role": "initial",
        "variable": "pressure",
        "where": "domain",
        "data": {
          "value": {
            "unit": "Pa",
            "meaning": "初始声压p0",
            "kind": "scalar",
            "shape": [
              1
            ]
          }
        },
        "required": true,
        "static": true
      },
      "initial_velocity": {
        "role": "initial",
        "variable": "velocity",
        "where": "domain",
        "data": {
          "value": {
            "unit": "m/s",
            "meaning": "初始粒子速度u0",
            "kind": "vector",
            "shape": [
              3
            ]
          }
        },
        "required": true,
        "static": true
      },
      "pressure": {
        "role": "boundary",
        "variable": "pressure",
        "where": "nodes",
        "data": {
          "value": {
            "unit": "Pa",
            "meaning": "给定声压pb",
            "kind": "scalar",
            "shape": [
              1
            ]
          }
        },
        "required": false,
        "static": false
      },
      "normal_velocity": {
        "role": "boundary",
        "variable": "normal_velocity",
        "where": "facets",
        "data": {
          "value": {
            "unit": "m/s",
            "meaning": "向域外的法向粒子速度",
            "kind": "scalar",
            "shape": [
              1
            ]
          }
        },
        "required": false,
        "static": false
      },
      "impedance": {
        "role": "boundary",
        "variable": "normal_velocity",
        "where": "facets",
        "data": {
          "impedance": {
            "unit": "Pa.s/m",
            "meaning": "实阻抗R>0",
            "kind": "scalar",
            "shape": [
              1
            ],
            "positive": true,
            "static": true
          },
          "drive": {
            "unit": "Pa",
            "meaning": "压力驱动pd",
            "kind": "scalar",
            "shape": [
              1
            ]
          }
        },
        "required": false,
        "static": false
      }
    },
    "outputs": {
      "pressure": {
        "unit": "Pa",
        "meaning": "声压p",
        "kind": "scalar",
        "shape": [
          1
        ],
        "where": "cells",
        "atol": 1e-05,
        "rtol": 0.01
      },
      "velocity": {
        "unit": "m/s",
        "meaning": "粒子速度u",
        "kind": "vector",
        "shape": [
          3
        ],
        "where": "cells",
        "atol": 1e-07,
        "rtol": 0.01
      }
    },
    "timeout": 900,
    "limits": {
      "cells": 3000,
      "nodes": 9000,
      "surface_faces": 800,
      "receivers": 128,
      "frames": 101,
      "components": 3000000
    }
  },
