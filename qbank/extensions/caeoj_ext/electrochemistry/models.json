{
  "ionic-equilibrium": {
    "name": "自洽空间电荷平衡",
    "dynamic": false,
    "parameters": {
      "temperature": {
        "unit": "K",
        "meaning": "恒定温度T>0",
        "positive": true
      },
      "gas_constant": {
        "unit": "J/(mol.K)",
        "meaning": "输入明确给定气体常数R>0",
        "positive": true
      },
      "faraday": {
        "unit": "C/mol",
        "meaning": "输入明确给定法拉第常数F>0",
        "positive": true
      },
      "species_count": {
        "unit": "1",
        "meaning": "离子及可选中性组分数s，JSON整数2..8",
        "integer": true,
        "lower": 2,
        "upper": 8
      },
      "length": {
        "unit": "m",
        "meaning": "液体区间长度L>0",
        "positive": true
      },
      "permittivity": {
        "unit": "F/m",
        "meaning": "绝对介电率ε>0，不是相对介电常数",
        "positive": true
      }
    },
    "locations": {
      "system": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 1,
        "meaning": "唯一均匀溶液材料对象"
      },
      "left": {
        "kind": "points",
        "minimum": 1,
        "maximum": 1,
        "meaning": "x=0的左电极液体侧边界"
      },
      "right": {
        "kind": "points",
        "minimum": 1,
        "maximum": 1,
        "meaning": "x=L的右电极液体侧边界"
      },
      "probes": {
        "kind": "points",
        "minimum": 1,
        "maximum": 256,
        "meaning": "真实观测点0≤x≤L，可重复坐标；边界浓度取液体迹"
      }
    },
    "records": {
      "ions": {
        "role": "material",
        "variable": "ions",
        "location": "system",
        "data": {
          "charge": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "1",
            "meaning": "电荷数z_i，整数−3..3；至少一个正与一个负，允许中性组分",
            "integral": true,
            "lower": -3,
            "upper": 3
          },
          "reservoir": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "mol/m3",
            "meaning": "φ=0储槽浓度c_i,∞>0；Σz_i c_i,∞=0",
            "positive": true
          }
        },
        "axis": "state"
      },
      "left": {
        "role": "boundary",
        "variable": "potential",
        "location": "left",
        "data": {
          "value": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "V",
            "meaning": "边界液体电势φ，相对于固定同一φ=0参考；正负均可"
          }
        },
        "axis": "state"
      },
      "right": {
        "role": "boundary",
        "variable": "potential",
        "location": "right",
        "data": {
          "value": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "V",
            "meaning": "边界液体电势φ，相对于固定同一φ=0参考；正负均可"
          }
        },
        "axis": "state"
      }
    },
    "outputs": {
      "surface_charge_left": {
        "kind": "scalar",
        "shape": [
          1
        ],
        "unit": "C/m2",
        "meaning": "该电极单位真实面积自由电荷，左−εφ_x(0)，右+εφ_x(L)，无Stern层",
        "location": "left",
        "atol": 1e-08,
        "rtol": 0.002
      },
      "surface_charge_right": {
        "kind": "scalar",
        "shape": [
          1
        ],
        "unit": "C/m2",
        "meaning": "该电极单位真实面积自由电荷，左−εφ_x(0)，右+εφ_x(L)，无Stern层",
        "location": "right",
        "atol": 1e-08,
        "rtol": 0.002
      },
      "potential": {
        "kind": "scalar",
        "shape": [
          1
        ],
        "unit": "V",
        "meaning": "液体电势φ(x)",
        "location": "probes",
        "atol": 2e-06,
        "rtol": 0.002
      },
      "concentration": {
        "kind": "components",
        "shape": [
          "s"
        ],
        "unit": "mol/m3",
        "meaning": "按液体体积计的组分浓度，轴i与输入一致",
        "location": "probes",
        "atol": 1e-06,
        "rtol": 0.002
      }
    },
    "timeout": 600
  },
