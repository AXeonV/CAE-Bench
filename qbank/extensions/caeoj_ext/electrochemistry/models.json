        "maximum": 1,
        "meaning": "唯一等电位导体，电势Φ相对于已固定公共参考"
      },
      "channels": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 32,
        "meaning": "导体表面的独立氧化还原反应通道；不共享库存，输入活度由外部储槽维持"
      }
    },
    "records": {
      "channels": {
        "role": "material",
        "variable": "channel",
        "location": "channels",
        "data": {
          "area": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "m2",
            "meaning": "该通道真实反应面积A>0",
            "positive": true
          },
          "electrons": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "1",
            "meaning": "反应R→O+n e⁻的n，精确整数1..4",
            "integral": true,
            "lower": 1,
            "upper": 4
          },
          "alpha": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "1",
            "meaning": "阴极指数系数α，0<α<1",
            "positive": true,
            "upper_exclusive": 1
          },
          "rate": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "mol/(m2.s)",
            "meaning": "标准面摩尔速率k>0",
            "positive": true
          },
          "standard_potential": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "V",
            "meaning": "标准还原电位E0，相对于同一公共参考"
          },
          "solution_potential": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "V",
            "meaning": "本通道电解液电势φl，同一公共参考"
          },
          "reduced_activity": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "1",
            "meaning": "还原态无量纲活度aR>0",
            "positive": true
          },
          "oxidized_activity": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "1",
            "meaning": "氧化态无量纲活度aO>0",
            "positive": true
          }
        },
        "axis": "state"
      }
    },
    "outputs": {
      "metal_potential": {
        "kind": "scalar",
        "shape": [
          1
        ],
