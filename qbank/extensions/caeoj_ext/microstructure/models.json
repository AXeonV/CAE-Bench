{
  "binary-separation": {
    "name": "非线性迁移率二元相分离",
    "state_size": 1,
    "parameters": {
      "length_x": {
        "unit": "m",
        "meaning": "周期长度Lx>0",
        "positive": true,
        "lower": 1e-09,
        "upper": 0.001
      },
      "length_y": {
        "unit": "m",
        "meaning": "周期长度Ly>0",
        "positive": true,
        "lower": 1e-09,
        "upper": 0.001
      },
      "energy_scale": {
        "unit": "J/m3",
        "meaning": "自由能系数A>0",
        "positive": true,
        "lower": 1.0,
        "upper": 1000000000.0
      },
      "gradient": {
        "unit": "J/m",
        "meaning": "梯度能系数κ>0",
        "positive": true
      },
      "mobility": {
        "unit": "m5/(J.s)",
        "meaning": "M0>0，按本题守恒动力学定义",
        "positive": true,
        "lower": 1e-30,
        "upper": 1e-06
      },
      "mobility_contrast": {
        "unit": "1",
        "meaning": "非线性迁移率系数α≥0，允许0",
        "lower": 0.0,
        "upper": 4.0
      }
    },
    "records": {
      "offset": {
        "role": "initial",
        "variable": "state_offset",
        "location": "system",
        "axis": "static",
        "data": {
          "value": {
            "unit": "1",
            "meaning": "初态各分量空间均值m_a，顺序[c]",
            "shape": [
              "s"
            ],
            "kind": "components"
          }
        }
      },
      "series": {
        "role": "initial",
        "variable": "initial_series",
        "location": "modes",
        "axis": "static",
        "data": {
          "wave": {
            "unit": "1",
            "meaning": "整数波矢(kx,ky)，由float64精确整数存储，不是物理波数",
            "shape": [
              2
            ],
            "kind": "components"
          },
          "amplitude": {
            "unit": "1",
            "meaning": "每状态的cos／sin系数，shape=[s,2]最内层依次a、b",
            "shape": [
              "s",
              2
            ],
            "kind": "components"
          }
        }
      }
    },
    "outputs": {
      "composition": {
        "unit": "1",
        "meaning": "c，成分偏差点值",
        "shape": [
          1
        ],
        "kind": "scalar"
      },
      "chemical_potential": {
        "unit": "J/m3",
        "meaning": "μ或μc，按本题公式的绝对势，无任意常量平移",
        "shape": [
          1
        ],
        "kind": "scalar"
      }
    },
    "state_order": "[c]"
  },
