              3
            ],
            "unit": "m",
            "meaning": "在z=0的起点"
          },
          "direction": {
            "kind": "vector",
            "shape": [
              3
            ],
            "unit": "1",
            "meaning": "入射单位方向，d_z≥1e−4"
          }
        }
      }
    },
    "outputs": {
      "terminal_position": {
        "kind": "vector",
