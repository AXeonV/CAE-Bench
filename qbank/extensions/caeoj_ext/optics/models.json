        "rtol": 0
      },
      "terminal_direction": {
        "kind": "vector",
        "shape": [
          3
        ],
        "unit": "1",
        "meaning": "终点方向",
        "location": "rays",
        "atol": 1e-08,
        "rtol": 0
      },
      "optical_path": {
        "kind": "scalar",
        "shape": [
          1
        ],
        "unit": "m",
        "meaning": "从发射到终止的∫n ds",
        "location": "rays",
        "atol": 1e-08,
        "rtol": 1e-06
