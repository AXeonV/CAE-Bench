        "kind": "points",
        "minimum": 1,
        "maximum": 128,
        "meaning": "真实位置x，严格在层内部，排除全部界面与两端；不作空间重建"
      }
    },
    "records": {
      "layers": {
        "role": "material",
        "variable": "layer",
        "location": "layers",
        "data": {
          "width": {
            "unit": "m",
            "meaning": "层厚h>0",
            "kind": "scalar",
            "shape": [
              1
            ],
            "positive": true
          }
        },
        "axis": "static"
      },
      "medium": {
        "role": "material",
        "variable": "medium",
        "location": "layers",
        "data": {
          "absorption": {
            "unit": "1/m",
            "meaning": "宏观吸收Σa_g>0",
            "kind": "components",
            "shape": [
              "g"
            ],
            "positive": true
          },
          "scatter": {
            "unit": "1/m",
            "meaning": "各向同性群转移S[g,h]≥0，第一轴出射群g、第二轴入射群h；含自散射",
            "kind": "components",
            "shape": [
              "g",
              "g"
            ],
            "nonnegative": true
          }
        },
        "axis": "static"
      },
      "source": {
        "role": "source",
        "variable": "source",
        "location": "layers",
        "data": {
          "value": {
            "unit": "1/(m3.s)",
            "meaning": "层内常量总群体源q_g≥0；各向同性角源q_g/2",
            "kind": "components",
            "shape": [
              "g"
            ],
            "nonnegative": true
          }
        },
        "axis": "static"
      },
      "incoming": {
        "role": "boundary",
        "variable": "incoming",
        "location": "system",
        "data": {
          "left": {
            "unit": "1/(m2.s)",
            "meaning": "x=0、μ>0的角通量ψ=L_g≥0，入射半球内不依赖μ",
            "kind": "components",
            "shape": [
              "g"
            ],
            "nonnegative": true
          },
          "right": {
            "unit": "1/(m2.s)",
            "meaning": "x=H、μ<0的角通量ψ=R_g≥0，入射半球内不依赖μ",
            "kind": "components",
            "shape": [
              "g"
            ],
            "nonnegative": true
          }
        },
        "axis": "static"
      }
    },
    "outputs": {
      "scalar_flux": {
        "unit": "1/(m2.s)",
        "meaning": "各群标量通量φ_g，保持输入激励确定的绝对幅值，不另作归一化",
        "kind": "components",
        "shape": [
          "g"
        ],
        "location": "probes",
        "atol": 1e-08,
        "rtol": 0.005
      },
      "current": {
        "unit": "1/(m2.s)",
        "meaning": "各群沿+x的净粒子流J_g，可为负",
        "kind": "components",
        "shape": [
          "g"
        ],
        "location": "probes",
        "atol": 1e-08,
        "rtol": 0.005
      }
    },
    "timeout": 1200,
    "transient": false,
    "output_axis": "static",
    "name": "稳态多群平板粒子输运"
  },
