{
  "photon-absorption": {
    "parameters": {
      "group_count": {
        "unit": "1",
        "meaning": "群数G，JSON整数1..4；各群是输入给定有效响应的离散群，无隐含能群宽度权重",
        "integer": true,
        "lower": 1,
        "upper": 4
      }
    },
    "locations": {
      "layers": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 32,
        "meaning": "按IDs行序沿+x排列的材料层对象，x=0起始；层内参数常值"
      },
      "system": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 1,
        "meaning": "完整平板系统对象，ID固定0"
      }
    },
    "records": {
      "layers": {
        "role": "material",
        "variable": "layer",
        "location": "layers",
        "data": {
          "width": {
            "unit": "m",
            "meaning": "层厚h>0",
            "kind": "scalar",
            "shape": [
              1
            ],
            "positive": true
          }
        },
        "axis": "static"
      },
      "absorption": {
        "role": "material",
        "variable": "absorption",
        "location": "layers",
        "data": {
          "sigma": {
            "unit": "1/m",
            "meaning": "宏观纯吸收Σ_g≥0",
            "kind": "components",
            "shape": [
              "g"
            ],
            "nonnegative": true
          }
        },
        "axis": "static"
      },
      "beam": {
        "role": "source",
        "variable": "beam",
        "location": "system",
        "data": {
          "flux": {
            "unit": "1/(m2.s)",
            "meaning": "x=0处向+x法向准直入射群粒子通量F_g≥0",
            "kind": "components",
            "shape": [
              "g"
            ],
            "nonnegative": true
          },
          "energy": {
            "unit": "J",
            "meaning": "群内每粒子能量E_g>0；按群行序",
            "kind": "components",
            "shape": [
              "g"
            ],
            "positive": true
          }
        },
        "axis": "static"
      }
    },
    "outputs": {
      "transmitted_flux": {
        "unit": "1/(m2.s)",
        "meaning": "x=H处各群出射法向通量",
        "kind": "components",
        "shape": [
          "g"
        ],
        "location": "system",
        "atol": 1e-08,
        "rtol": 0.005
      },
      "deposited_power": {
        "unit": "W/m2",
        "meaning": "该层所吸收能量的每横截面积功率，属于层对象的集总响应",
        "kind": "scalar",
        "shape": [
          1
        ],
        "location": "layers",
        "atol": 1e-08,
        "rtol": 0.005
      }
    },
    "timeout": 600,
    "transient": false,
    "output_axis": "static",
    "name": "多群光子纯吸收与能量沉积"
  },
  "slab-transport-steady": {
