{
  "fick-diffusion": {
    "name": "多组分瞬态扩散",
    "transport": true,
    "parameters": {
      "species_count": {
        "unit": "1",
        "meaning": "组分数s，JSON整数1..8",
        "integer": true,
        "lower": 1,
        "upper": 8
      },
      "length": {
        "unit": "m",
        "meaning": "区间长度L>0",
        "positive": true
      }
    },
    "locations": {
      "system": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 1,
        "meaning": "唯一材料／动力学参数对象，不是空间探针"
      },
      "knots": {
        "kind": "points",
        "minimum": 2,
        "maximum": 257,
        "meaning": "初态空间结点，x严格递增，首尾恰为0、L"
      },
      "left": {
        "kind": "points",
        "minimum": 1,
        "maximum": 1,
        "meaning": "左端坐标x=0"
      },
      "right": {
        "kind": "points",
        "minimum": 1,
        "maximum": 1,
        "meaning": "右端坐标x=L"
      },
      "probes": {
        "kind": "points",
        "minimum": 1,
        "maximum": 256,
        "meaning": "严格位于0<x<L的独立接收点；坐标可重复，身份独立"
      }
    },
    "records": {
      "diffusivity": {
        "role": "material",
        "variable": "diffusivity",
        "location": "system",
        "data": {
          "value": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "m2/s",
            "meaning": "各组分常量有效扩散系数D_i>0",
            "positive": true
          }
        },
        "axis": "initial"
      },
      "initial": {
        "role": "initial",
        "variable": "concentration",
        "location": "knots",
        "data": {
          "value": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "mol/m3",
            "meaning": "t=0的移动相体积浓度c_i≥0",
            "nonnegative": true
          }
        },
        "axis": "initial"
      },
      "left": {
        "role": "boundary",
        "variable": "concentration",
        "location": "left",
        "data": {
          "value": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "mol/m3",
            "meaning": "该端移动相浓度Dirichlet历史，c_i≥0",
            "nonnegative": true
          }
        },
        "axis": "boundary"
      },
      "right": {
        "role": "boundary",
        "variable": "concentration",
        "location": "right",
        "data": {
          "value": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "mol/m3",
            "meaning": "该端移动相浓度Dirichlet历史，c_i≥0",
            "nonnegative": true
          }
        },
        "axis": "boundary"
      }
    },
    "outputs": {
      "concentration": {
        "kind": "components",
        "shape": [
          "s"
        ],
        "unit": "mol/m3",
        "meaning": "移动相体积浓度c_i(x,t)",
        "location": "probes"
      }
    }
  },
