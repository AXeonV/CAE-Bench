  "competitive-adsorption": {
    "name": "有限库存竞争吸附",
    "transport": false,
    "parameters": {
      "species_count": {
        "unit": "1",
        "meaning": "组分数s，JSON整数1..8",
        "integer": true,
        "lower": 1,
        "upper": 8
      },
      "capacity": {
        "unit": "mol/kg",
        "meaning": "公共位点容量qmax>0，每个吸附分子占一个位点",
        "positive": true
      },
      "solid_loading": {
        "unit": "kg/m3",
        "meaning": "单位液体体积的固体质量ρb>0",
        "positive": true
      }
    },
    "locations": {
      "system": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 1,
        "meaning": "唯一材料／动力学参数对象，不是空间探针"
      },
      "vessels": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 32,
        "meaning": "独立完全混合有限容积反应器／容器，IDs可不连续，各组分轴按c1..cs"
      }
    },
    "records": {
      "initial": {
        "role": "initial",
        "variable": "concentration",
        "location": "vessels",
        "data": {
          "value": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "mol/m3",
            "meaning": "初始浓度c_i≥0",
            "nonnegative": true
          }
        },
        "axis": "initial"
      },
      "sites": {
        "role": "material",
        "variable": "sites",
        "location": "system",
        "data": {
          "adsorption": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "m3/(mol.s)",
            "meaning": "吸附速率ka_i≥0",
            "nonnegative": true
          },
          "desorption": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "1/s",
            "meaning": "解吸速率kd_i≥0",
            "nonnegative": true
          }
        },
        "axis": "initial"
      },
      "initial_loading": {
        "role": "initial",
        "variable": "loading",
        "location": "vessels",
        "data": {
          "value": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "mol/kg",
            "meaning": "初始固相负载q_i≥0，逐位置Σq_i≤qmax",
            "nonnegative": true
          }
        },
        "axis": "initial"
      }
    },
    "outputs": {
      "concentration": {
        "kind": "components",
        "shape": [
          "s"
        ],
        "unit": "mol/m3",
        "meaning": "各容器内体积摩尔浓度c_i(t)",
        "location": "vessels"
      },
      "loading": {
        "kind": "components",
        "shape": [
          "s"
        ],
        "unit": "mol/kg",
        "meaning": "单位固体质量的吸附量q_i(t)，不乘固液比",
        "location": "vessels"
      }
    }
  },
