  "mass-action-network": {
    "name": "等温反应网络",
    "transport": false,
    "parameters": {
      "species_count": {
        "unit": "1",
        "meaning": "组分数s，JSON整数2..8；非平凡质量守恒反应至少需两个组分",
        "integer": true,
        "lower": 2,
        "upper": 8
      },
      "reaction_count": {
        "unit": "1",
        "meaning": "反应数r，JSON整数1..16",
        "integer": true,
        "lower": 1,
        "upper": 16
      },
      "concentration_scale": {
        "unit": "mol/m3",
        "meaning": "共同活度归一化浓度c*>0，不是初态",
        "positive": true
      }
    },
    "locations": {
      "system": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 1,
        "meaning": "唯一材料／动力学参数对象，不是空间探针"
      },
      "vessels": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 32,
        "meaning": "独立完全混合有限容积反应器／容器，IDs可不连续，各组分轴按c1..cs"
      },
      "reactions": {
        "kind": "entities",
        "minimum": 1,
        "maximum": 16,
        "meaning": "r条有向不可逆反应，按IDs行序；可逆反应必须显式给两条"
      }
    },
    "records": {
      "initial": {
        "role": "initial",
        "variable": "concentration",
        "location": "vessels",
        "data": {
          "value": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "mol/m3",
            "meaning": "初始浓度c_i≥0",
            "nonnegative": true
          }
        },
        "axis": "initial"
      },
      "kinetics": {
        "role": "material",
        "variable": "kinetics",
        "location": "reactions",
        "data": {
          "reactants": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "1",
            "meaning": "反应物计量α_ri，整数0..4，每行总和1..4",
            "integral": true,
            "lower": 0,
            "upper": 4
          },
          "products": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "1",
            "meaning": "生成物计量β_ri，整数0..4，每行总和1..8，β行不等于α行",
            "integral": true,
            "lower": 0,
            "upper": 4
          },
          "prefactor": {
            "kind": "scalar",
            "shape": [
              1
            ],
            "unit": "mol/(m3.s)",
            "meaning": "反应体积速率前因子a_r≥0，已用c*归一化，非传统随反应级数变单位的k",
            "nonnegative": true
          }
        },
        "axis": "initial"
      },
      "species": {
        "role": "material",
        "variable": "species",
        "location": "system",
        "data": {
          "molar_mass": {
            "kind": "components",
            "shape": [
              "s"
            ],
            "unit": "kg/mol",
            "meaning": "组分摩尔质量M_i>0；每行反应Σ(β−α)M=0",
            "positive": true
          }
        },
        "axis": "initial"
      }
    },
    "outputs": {
      "concentration": {
        "kind": "components",
        "shape": [
          "s"
        ],
        "unit": "mol/m3",
        "meaning": "各容器内体积摩尔浓度c_i(t)",
        "location": "vessels"
      }
    }
  },
