{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evaluator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "evaluator"
        ]
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "metric": {
          "const": "rms_nrmse"
        },
        "full_credit": {
          "type": "number",
          "minimum": 0
        },
        "zero_credit": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "metric",
        "full_credit",
        "zero_credit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "checks"
  ],
  "additionalProperties": false
}
