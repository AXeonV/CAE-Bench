{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evaluator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "evaluator"
        ]
      }
    }
  },
  "required": [
    "version",
    "checks"
  ],
  "additionalProperties": false
}
