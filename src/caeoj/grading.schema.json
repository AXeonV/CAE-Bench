{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "quantities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "$ref": "#/$defs/node"
          }
        },
        "required": [
          "unit",
          "rule"
        ],
        "additionalProperties": false
      }
    },
    "default": {
      "$ref": "#/$defs/node"
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "metric": {
              "const": "pointwise"
            },
            "time": {
              "enum": [
                "per_time",
                "pooled"
              ]
            },
            "components": {
              "enum": [
                "per_component",
                "joint"
              ]
            },
            "weight_field": {
              "type": "string",
              "minLength": 1
            },
            "atol": {
              "type": "number",
              "minimum": 0
            },
            "rtol": {
              "type": "number",
              "minimum": 0
            },
            "reference_offset": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/input_offset"
                }
              ]
            }
          },
          "required": [
            "metric",
            "time",
            "components",
            "atol",
            "rtol"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metric": {
              "const": "rmse"
            },
            "time": {
              "enum": [
                "per_time",
                "pooled"
              ]
            },
            "components": {
              "enum": [
                "per_component",
                "joint"
              ]
            },
            "weight_field": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "metric",
            "time",
            "components",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metric": {
              "const": "nrmse"
            },
            "time": {
              "enum": [
                "per_time",
                "pooled"
              ]
            },
            "components": {
              "enum": [
                "per_component",
                "joint"
              ]
            },
            "weight_field": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "number",
              "minimum": 0
            },
            "scale_floor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reference_offset": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/input_offset"
                }
              ]
            }
          },
          "required": [
            "metric",
            "time",
            "components",
            "limit",
            "scale_floor"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metric": {
              "const": "max_abs"
            },
            "time": {
              "enum": [
                "per_time",
                "pooled"
              ]
            },
            "components": {
              "enum": [
                "per_component",
                "joint"
              ]
            },
            "weight_field": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "metric",
            "time",
            "components",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metric": {
              "const": "max_scaled"
            },
            "time": {
              "enum": [
                "per_time",
                "pooled"
              ]
            },
            "components": {
              "enum": [
                "per_component",
                "joint"
              ]
            },
            "weight_field": {
              "type": "string",
              "minLength": 1
            },
            "atol": {
              "type": "number",
              "minimum": 0
            },
            "rtol": {
              "type": "number",
              "minimum": 0
            },
            "limit": {
              "type": "number",
              "minimum": 0
            },
            "reference_offset": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/input_offset"
                }
              ]
            }
          },
          "required": [
            "metric",
            "time",
            "components",
            "atol",
            "rtol",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metric": {
              "const": "violation_fraction"
            },
            "time": {
              "enum": [
                "per_time",
                "pooled"
              ]
            },
            "components": {
              "enum": [
                "per_component",
                "joint"
              ]
            },
            "weight_field": {
              "type": "string",
              "minLength": 1
            },
            "atol": {
              "type": "number",
              "minimum": 0
            },
            "rtol": {
              "type": "number",
              "minimum": 0
            },
            "limit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "count": {
              "enum": [
                "scalar_values",
                "spatial_points"
              ]
            },
            "reference_offset": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/input_offset"
                }
              ]
            }
          },
          "required": [
            "metric",
            "time",
            "components",
            "atol",
            "rtol",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input_offset": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "parameter"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "version": {
          "const": 1
        }
      },
      "required": [
        "fields"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "quantities"
            ]
          },
          {
            "required": [
              "default"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "version": {
          "const": 2
        }
      },
      "anyOf": [
        {
          "required": [
            "quantities"
          ]
        },
        {
          "required": [
            "default"
          ]
        }
      ],
      "not": {
        "required": [
          "fields"
        ]
      }
    }
  ]
}
