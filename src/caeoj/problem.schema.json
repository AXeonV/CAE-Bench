{
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "spatial_dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "data_file": {
      "type": "string",
      "minLength": 1
    },
    "geometries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/geometry"
      }
    },
    "meshes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mesh"
      }
    },
    "locations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/location"
      }
    },
    "time_axes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "physics": {
      "$ref": "#/$defs/physics"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "contract_version": {
      "const": 2,
      "type": "integer"
    },
    "profile": {
      "const": "cfd-2.1"
    },
    "analysis": {
      "$ref": "#/$defs/cfd_analysis"
    },
    "materials": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/cfd_material"
      }
    }
  },
  "required": [
    "spatial_dimension",
    "data_file",
    "geometries",
    "meshes",
    "locations",
    "time_axes",
    "fields",
    "outputs",
    "conditions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "通用数据协议",
  "$defs": {
    "constant": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "array": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "time_axis": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "dtype": {
          "enum": [
            "float64",
            "int64",
            "bool"
          ]
        },
        "kind": {
          "enum": [
            "scalar",
            "vector",
            "tensor",
            "components"
          ]
        },
        "component_shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value_kind": {
          "enum": [
            "point",
            "average",
            "integral"
          ]
        },
        "sampling": {
          "type": "object",
          "properties": {
            "space": {
              "enum": [
                "uniform",
                "piecewise_constant",
                "piecewise_linear"
              ]
            },
            "time": {
              "enum": [
                "constant",
                "linear",
                "previous"
              ]
            },
            "extrapolation": {
              "enum": [
                "forbid",
                "hold"
              ]
            }
          },
          "required": [
            "space",
            "time",
            "extrapolation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "array",
        "quantity",
        "location",
        "time_axis",
        "dtype",
        "kind",
        "component_shape",
        "components",
        "unit",
        "value_kind"
      ],
      "additionalProperties": false
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "mesh"
            },
            "mesh": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "entity": {
              "enum": [
                "node",
                "element"
              ]
            },
            "ids": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "dimension": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "physical_group": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "tag": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "dimension",
                "tag"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "mesh",
            "entity",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "points"
            },
            "ids": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "coordinates": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "ids",
            "coordinates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "source": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "ids": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "operation": {
              "enum": [
                "sum",
                "mean"
              ]
            }
          },
          "required": [
            "kind",
            "source",
            "ids",
            "operation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "geometry": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "gmsh-geo",
            "step",
            "brep"
          ]
        }
      },
      "required": [
        "file",
        "format"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/constant"
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "location"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "option": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "option"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "boundary",
            "initial",
            "source",
            "material"
          ]
        },
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          },
          "minProperties": 0
        }
      },
      "required": [
        "role",
        "variable",
        "location",
        "operator",
        "data"
      ],
      "additionalProperties": false
    },
    "physics": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/constant"
          }
        }
      },
      "required": [
        "model",
        "parameters"
      ],
      "additionalProperties": false
    },
    "cfd_pressure": {
      "type": "object",
      "properties": {
        "representation": {
          "enum": [
            "absolute",
            "gauge"
          ]
        },
        "reference_pressure": {
          "$ref": "#/$defs/constant"
        }
      },
      "required": [
        "representation"
      ],
      "additionalProperties": false
    },
    "cfd_gauge": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "mean",
            "point"
          ]
        },
        "location": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "value": {
          "$ref": "#/$defs/constant"
        }
      },
      "required": [
        "kind",
        "location",
        "value"
      ],
      "additionalProperties": false
    },
    "cfd_analysis": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "steady",
            "transient"
          ]
        },
        "compressibility": {
          "enum": [
            "incompressible",
            "isothermal_compressible"
          ]
        },
        "flow_regime": {
          "const": "laminar"
        },
        "temperature": {
          "$ref": "#/$defs/constant"
        },
        "pressure": {
          "$ref": "#/$defs/cfd_pressure"
        },
        "time_interval": {
          "type": "object",
          "properties": {
            "start": {
              "type": "number"
            },
            "end": {
              "type": "number"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "pressure_gauge": {
          "$ref": "#/$defs/cfd_gauge"
        },
        "mean_density": {
          "$ref": "#/$defs/constant"
        }
      },
      "required": [
        "type",
        "compressibility",
        "flow_regime",
        "temperature",
        "pressure"
      ],
      "additionalProperties": false
    },
    "cfd_material": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "density": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "constant",
                "isothermal_ideal_gas",
                "linear_barotropic"
              ]
            },
            "parameters": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/constant"
              }
            }
          },
          "required": [
            "kind",
            "parameters"
          ],
          "additionalProperties": false
        },
        "viscosity": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "newtonian",
                "power_law",
                "cross",
                "carreau",
                "carreau_yasuda"
              ]
            },
            "parameters": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/constant"
              }
            }
          },
          "required": [
            "kind",
            "parameters"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "region",
        "density",
        "viscosity"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "contract_version"
            ]
          },
          {
            "required": [
              "profile"
            ]
          },
          {
            "required": [
              "analysis"
            ]
          },
          {
            "required": [
              "materials"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "contract_version",
          "profile",
          "analysis",
          "materials"
        ]
      },
      "else": {
        "properties": {
          "conditions": {
            "items": {
              "properties": {
                "data": {
                  "minProperties": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "physics"
        ],
        "properties": {
          "physics": {
            "required": [
              "model"
            ],
            "properties": {
              "model": {
                "pattern": "^fluid-(energy|multiphase|reduced)-"
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "contract_version"
              ]
            },
            {
              "required": [
                "profile"
              ]
            },
            {
              "required": [
                "analysis"
              ]
            },
            {
              "required": [
                "materials"
              ]
            }
          ]
        }
      }
    }
  ]
}
