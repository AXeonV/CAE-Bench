{
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "spatial_dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "data_file": {
      "type": "string",
      "minLength": 1
    },
    "geometries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/geometry"
      }
    },
    "meshes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mesh"
      }
    },
    "locations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/location"
      }
    },
    "time_axes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "physics": {
      "$ref": "#/$defs/physics"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      }
    }
  },
  "required": [
    "spatial_dimension",
    "data_file",
    "geometries",
    "meshes",
    "locations",
    "time_axes",
    "fields",
    "outputs",
    "conditions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "通用数据协议",
  "$defs": {
    "constant": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "array": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "time_axis": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "dtype": {
          "enum": [
            "float64",
            "int64",
            "bool"
          ]
        },
        "kind": {
          "enum": [
            "scalar",
            "vector",
            "tensor",
            "components"
          ]
        },
        "component_shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value_kind": {
          "enum": [
            "point",
            "average",
            "integral"
          ]
        }
      },
      "required": [
        "array",
        "quantity",
        "location",
        "time_axis",
        "dtype",
        "kind",
        "component_shape",
        "components",
        "unit",
        "value_kind"
      ],
      "additionalProperties": false
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "mesh"
            },
            "mesh": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "entity": {
              "enum": [
                "node",
                "element"
              ]
            },
            "ids": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "dimension": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "physical_group": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "tag": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "dimension",
                "tag"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "mesh",
            "entity",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "points"
            },
            "ids": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "coordinates": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "ids",
            "coordinates"
          ],
          "additionalProperties": false
        }
      ]
    },
    "geometry": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "gmsh-geo",
            "step",
            "brep"
          ]
        }
      },
      "required": [
        "file",
        "format"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/constant"
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "boundary",
            "initial",
            "source",
            "material"
          ]
        },
        "variable": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          },
          "minProperties": 1
        }
      },
      "required": [
        "role",
        "variable",
        "location",
        "operator",
        "data"
      ],
      "additionalProperties": false
    },
    "physics": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/constant"
          }
        }
      },
      "required": [
        "model",
        "parameters"
      ],
      "additionalProperties": false
    }
  }
}
